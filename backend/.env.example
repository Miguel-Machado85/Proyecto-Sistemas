# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# ── Gemini ──
GOOGLE_API_KEY=
# Embeddings: NO cambiar (Chroma ya está indexado con este modelo)
EMBEDDING_MODEL=models/gemini-embedding-2

# Modelos de chat (flash-lite para clasificar, flash para investigar y redactar)
ANALISTA_MODEL=gemini-3.5-flash-lite
EVALUADOR_MODEL=gemini-3.5-flash-lite
INVESTIGADOR_MODEL=gemini-3.5-flash
REDACTOR_MODEL=gemini-3.5-flash
LLM_MAX_RETRIES=3

# Audio (STT / TTS)
AUDIO_MODEL=gemini-3.5-transcribe
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
MAX_AUDIO_BYTES=15728640

# ── Grafo multi-agente ──
MAX_INTENTOS_BUSQUEDA=2
INVESTIGADOR_MAX_PASOS=10
MAX_HISTORIAL_ANALISTA=6
EVALUADOR_HABILITADO=true
# postgres | memory
CHECKPOINTER=postgres

# ── Reranker ──
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_HABILITADO=true
RERANKER_PRECARGAR=false
# 1 = sin consultar Hugging Face (con el modelo ya en la caché local / volumen hf-cache)
HF_HUB_OFFLINE=0

# ── Chroma ──
COLLECTION_NAME=langchain
# Carpeta local: solo modo local (tests, desarrollo) y origen de la migración. Nunca se escribe en modo http.
CHROMA_PERSIST_DIR=./chroma_db

# ── Chroma como servicio (etapa archivos del agente) ──
# local = carpeta embebida | http = servidor Chroma (en Compose se fuerza http con host `chroma`)
CHROMA_MODO=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# ── Carga administrativa de documentos ──
# Debe ser un secreto distinto de la API key de Gemini. No lo publiques.
ADMIN_UPLOAD_TOKEN=
UPLOAD_ROOT=./documentos
MAX_DOCUMENT_BYTES=26214400
MAX_DOCUMENTS_PER_BATCH=20
# Compatibles con los documentos ya indexados.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=25
# La ingesta histórica esperaba 20 s entre lotes para respetar la cuota de Gemini.
EMBEDDING_BATCH_PAUSE_SECONDS=20

# ── PostgreSQL ──
# En Docker Compose esta variable se sobreescribe hacia el servicio "db".
DATABASE_URL=postgresql://sigem:sigem@localhost:55432/sigem

# ── AWS S3 (audios) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
PRESIGNED_URL_EXPIRATION=3600

# ── Langfuse (opcional: sin claves, el tracing se desactiva) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
