# Copia este archivo a .env y completa los valores. No subas .env al repositorio.

# ── Gemini ──
GOOGLE_API_KEY=
# Embeddings: NO cambiar (Chroma ya está indexado con este modelo)
EMBEDDING_MODEL=models/gemini-embedding-2

# Modelos de chat (flash-lite para clasificar, flash para investigar y redactar)
ANALISTA_MODEL=gemini-3.5-flash-lite
EVALUADOR_MODEL=gemini-3.5-flash-lite
INVESTIGADOR_MODEL=gemini-3.5-flash
REDACTOR_MODEL=gemini-3.5-flash
LLM_MAX_RETRIES=3

# Audio (STT / TTS)
AUDIO_MODEL=gemini-3.5-transcribe
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_VOICE=Kore
MAX_AUDIO_BYTES=15728640

# ── Grafo multi-agente ──
MAX_INTENTOS_BUSQUEDA=2
INVESTIGADOR_MAX_PASOS=10
MAX_HISTORIAL_ANALISTA=6
EVALUADOR_HABILITADO=true
# postgres | memory
CHECKPOINTER=postgres

# ── Reranker ──
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_HABILITADO=true
RERANKER_PRECARGAR=false
# 1 = sin consultar Hugging Face (con el modelo ya en la caché local / volumen hf-cache)
HF_HUB_OFFLINE=0

# ── Chroma ──
COLLECTION_NAME=langchain
# Carpeta local: solo modo local (tests, desarrollo) y origen de la migración. Nunca se escribe en modo http.
CHROMA_PERSIST_DIR=./chroma_db

# ── Chroma como servicio (etapa archivos del agente) ──
# local = carpeta embebida | http = servidor Chroma (en Compose se fuerza http con host `chroma`)
CHROMA_MODO=local
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_SSL=false

# ── Carga administrativa de documentos ──
# ── SPRINT 7: credenciales del único administrador ──
# La contraseña se guarda como hash bcrypt. Docker Compose interpreta `$`, por eso
# en backend/.env duplica cada `$` del hash generado: `$2b$...` pasa a `$$2b$$...`.
# nunca en texto plano. Genera el hash con:
# python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
ADMIN_USERNAME=administrador
ADMIN_PASSWORD_HASH=
# Secreto aleatorio largo para firmar las sesiones JWT. Por ejemplo:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_JWT_SECRET=
# Tiempo máximo de la sesión en horas. En HTTPS público activa ADMIN_COOKIE_SECURE=true.
ADMIN_SESSION_HOURS=8
ADMIN_COOKIE_SECURE=false
# Orígenes autorizados a enviar la cookie de administración, separados por comas.
ADMIN_CORS_ORIGINS=http://localhost:8080
UPLOAD_ROOT=./documentos
MAX_DOCUMENT_BYTES=26214400
MAX_DOCUMENTS_PER_BATCH=20
# Compatibles con los documentos ya indexados.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=25
# La ingesta histórica esperaba 20 s entre lotes para respetar la cuota de Gemini.
EMBEDDING_BATCH_PAUSE_SECONDS=20

# ── PostgreSQL ──
# En Docker Compose esta variable se sobreescribe hacia el servicio "db".
DATABASE_URL=postgresql://sigem:sigem@localhost:55432/sigem

# ── AWS S3 (audios) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
PRESIGNED_URL_EXPIRATION=3600

# ── Archivos originales y Google Drive (etapa archivos del agente) ──
# local = carpeta UPLOAD_ROOT/repositorio (sin credenciales) | drive = carpeta de Google Drive
ARCHIVOS_BACKEND=local
# Acepta el ID o la URL completa de la carpeta de Drive. La cuenta que autoriza el token debe ser Editor de la carpeta
# (compartida por correo) y el acceso general del enlace debe quedar en Lector o restringido.
GOOGLE_DRIVE_FOLDER_ID=
# Fuera de Git (backend/secrets/). En Compose se montan en /app/secrets de solo lectura.
# El cliente se descarga de Google Cloud (tipo "Aplicación de escritorio"); el token lo crea scripts/autorizar_drive.py
# (caduca a los 7 días si la app OAuth está en modo Pruebas).
GOOGLE_OAUTH_CLIENT_FILE=./secrets/oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=./secrets/oauth-token.json
# stream = el backend reenvía el archivo | redirect = 302 al enlace de Drive
DRIVE_MODO_ENTREGA=stream

# ── Langfuse (opcional: sin claves, el tracing se desactiva) ──
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
